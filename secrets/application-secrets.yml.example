# Example secrets file - DO NOT commit actual keys
# Copy this to application-secrets.yml and fill in your keys

llm:
  # Use environment variables or secrets manager in production
  api-keys: "${GEMINI_API_KEYS:your-api-key-here}"
  model: gemini-2.0-flash
  temperature: 0.0
  max-output-tokens: 1024

# Alternative: Use Ollama (no API keys needed)
# llm:
#   ollama:
#     url: http://localhost:11434
#     model: llama3.2
