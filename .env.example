# Example Environment Configuration
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env to git!

# Gemini API Keys (comma-separated)
# Get keys from: https://aistudio.google.com/app/apikey
# Free tier: 15 RPM, 1500 RPD per key
# With 20 keys: ~240 RPM, ~29,000 RPD total

GEMINI_API_KEYS="AIzaSy...,AIzaSy...,AIzaSy...,AIzaSy...,AIzaSy...,AIzaSy...,AIzaSy...,AIzaSy...,AIzaSy...,AIzaSy...,AIzaSy...,AIzaSy...,AIzaSy...,AIzaSy...,AIzaSy...,AIzaSy...,AIzaSy...,AIzaSy...,AIzaSy...,AIzaSy..."

# Optional: Override default model
# LLM_MODEL=gemini-2.0-flash

# Optional: Override temperature (0.0 = deterministic)
# LLM_TEMPERATURE=0.0

# Optional: Override max output tokens
# LLM_MAX_OUTPUT_TOKENS=1024
